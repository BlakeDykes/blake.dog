{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blake-dog-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-15",
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  "vars": {
    "PUBLIC_APP_ORIGIN": "http://localhost:5173",
    "PUBLIC_MEDIA_URL": "",
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "ADMIN_USERNAME",
      "ADMIN_PASSWORD_HASH",
      "JWT_SECRET",
    ],
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "blake-dog-media",
      "preview_bucket_name": "blake-dog-media-dev",
    },
  ],

  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
